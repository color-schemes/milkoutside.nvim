{
  "manifest_version": 3,
  "name": "MilkOutside Theme",
  "version": "1.0.1",
  "description": "MilkOutside dark theme for Safari",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MilkOutside Theme"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["milkoutside.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["milkoutside.css"],
      "matches": ["<all_urls>"]
    }
  ]
}