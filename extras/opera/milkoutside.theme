Popup=13,13,13

# Text colors
TabText=232,232,232
TabBackgroundText=224,224,224
BookmarkText=232,232,232
NtpText=232,232,232
NtpLink=253,161,160
ButtonForeground=232,232,232
AddressBarText=232,232,232
SidebarText=232,232,232
PopupText=232,232,232
ToolbarButtonIcon=232,232,232

# Accent colors
NtpHeader=232,232,232
